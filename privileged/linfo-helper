#!/usr/bin/python3 -I
"""LinFo installed, root-owned privileged helper.

A deliberately tiny allowlist, no shell, no arbitrary path/command/value from caller.
The GUI must never use sudo/pkexec to run itself or a helper from a writable tree.
"""
from __future__ import annotations
import base64
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import uuid

CONFIG = Path("/etc/sysctl.d/99-zz-linfo-hardening.conf")
STATE = Path("/var/lib/linfo/changes")
ACTIONS = {
    "aslr": {"kernel.randomize_va_space": "2"},
    "protected_links": {"fs.protected_hardlinks": "1", "fs.protected_symlinks": "1"},
    "ptrace": {"kernel.yama.ptrace_scope": "1"},
    "icmp_redirects": {"net.ipv4.conf.all.accept_redirects": "0", "net.ipv4.conf.default.accept_redirects": "0",
                       "net.ipv4.conf.all.send_redirects": "0", "net.ipv4.conf.default.send_redirects": "0"},
    "source_route": {"net.ipv4.conf.all.accept_source_route": "0", "net.ipv4.conf.default.accept_source_route": "0"},
}
ALL_KEYS = {key for values in ACTIONS.values() for key in values}


def ensure_safe_dir(path: Path, create: bool = False) -> None:
    if create:
        path.mkdir(parents=True, exist_ok=True, mode=0o700)
    meta = path.lstat()
    if not stat.S_ISDIR(meta.st_mode) or meta.st_uid != 0 or meta.st_mode & 0o022:
        raise RuntimeError(f"Unsafe directory owner or permissions: {path}")


def file_bytes() -> tuple[bytes | None, int]:
    try:
        mode = CONFIG.lstat()
    except FileNotFoundError:
        return None, 0o644
    if not stat.S_ISREG(mode.st_mode) or mode.st_uid != 0 or mode.st_mode & 0o022:
        raise RuntimeError("Refusing unsafe or writable/symlinked configuration file")
    if mode.st_size > 131072:
        raise RuntimeError("Configuration unexpectedly large; manual review required")
    return CONFIG.read_bytes(), stat.S_IMODE(mode.st_mode)


def atomic_file(content: bytes | None, mode: int = 0o644) -> None:
    # Caller has validated CONFIG and its root-owned parent. No caller-supplied path.
    if content is None:
        CONFIG.unlink(missing_ok=True)
        return
    temp = CONFIG.parent / (".linfo-" + uuid.uuid4().hex)
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temp, mode)
        os.replace(temp, CONFIG)
    finally:
        temp.unlink(missing_ok=True)


def key_path(key: str) -> Path:
    if key not in ALL_KEYS:
        raise RuntimeError("Unexpected sysctl key")
    return Path("/proc/sys") / key.replace(".", "/")


def current(key: str) -> str:
    return key_path(key).read_text(encoding="ascii").strip()


def set_runtime(key: str, value: str) -> None:
    if not re.fullmatch(r"[0-3]", value) or key not in ALL_KEYS:
        raise RuntimeError("Unexpected sysctl value")
    key_path(key).write_text(value + "\n", encoding="ascii")
    if current(key) != value:
        raise RuntimeError(f"Runtime validation failed for {key}")


def digest(data: bytes | None) -> str | None:
    return hashlib.sha256(data).hexdigest() if data is not None else None


def verify_conflicts(values: dict[str, str]) -> None:
    # sysctl --system applies /etc/sysctl.conf last on many distributions.
    # Refuse to claim durable persistence when an existing later setting disagrees.
    potential = [Path("/etc/sysctl.conf")]
    for folder in ("/etc/sysctl.d", "/run/sysctl.d", "/usr/lib/sysctl.d", "/usr/local/lib/sysctl.d"):
        directory = Path(folder)
        if directory.exists():
            potential.extend(x for x in directory.glob("*.conf") if x.name > CONFIG.name)
    for path in potential:
        if path == CONFIG or not path.is_file():
            continue
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except (OSError, UnicodeError):
            raise RuntimeError(f"Cannot inspect later sysctl file: {path}")
        for line in lines:
            line = line.strip()
            if not line or line.startswith(("#", ";", "-")) or "=" not in line:
                continue
            key, val = (x.strip() for x in line.split("=", 1))
            if key in values and val != values[key]:
                raise RuntimeError(f"Conflicting persistent sysctl setting in {path}: {key}. Resolve manually first.")


def merge_config(old: bytes | None, desired: dict[str, str]) -> bytes:
    try:
        source = (old or b"").decode("utf-8")
    except UnicodeDecodeError:
        raise RuntimeError("Existing configuration is not UTF-8; inspect manually")
    lines = []
    for line in source.splitlines():
        stripped = line.strip()
        if "=" in stripped and not stripped.startswith(("#", ";")):
            key = stripped.split("=", 1)[0].strip()
            if key in desired:
                continue
        lines.append(line)
    lines.extend(f"{key} = {value}" for key, value in desired.items())
    return ("\n".join(lines).rstrip() + "\n").encode("utf-8")


def create_manifest(manifest: dict) -> str:
    transaction = str(uuid.uuid4())
    path = STATE / (transaction + ".json")
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(manifest, stream, sort_keys=True, indent=2)
            stream.flush()
            os.fsync(stream.fileno())
    except BaseException:
        path.unlink(missing_ok=True)
        raise
    return transaction


def save_manifest(transaction: str, manifest: dict) -> None:
    tmp = STATE / (".receipt-" + uuid.uuid4().hex)
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(manifest, stream, indent=2, sort_keys=True)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, STATE / (transaction + ".json"))
    finally:
        tmp.unlink(missing_ok=True)


def apply(action_ids: list[str]) -> dict:
    if not action_ids or len(action_ids) > len(ACTIONS) or len(set(action_ids)) != len(action_ids):
        raise RuntimeError("Invalid or duplicate actions")
    if any(a not in ACTIONS for a in action_ids):
        raise RuntimeError("Unknown action")
    ensure_safe_dir(CONFIG.parent)
    ensure_safe_dir(STATE, create=True)
    desired: dict[str, str] = {}
    for action in action_ids:
        desired.update(ACTIONS[action])
    verify_conflicts(desired)
    old, old_mode = file_bytes()
    previous = {key: current(key) for key in desired}
    new = merge_config(old, desired)
    if old == new and all(previous[k] == v for k, v in desired.items()):
        return {"result": "already_conformant", "actions": action_ids, "receipt": None}
    # Durable pre-change snapshot before mutation, root-only receipt.
    receipt = create_manifest({"status": "prepared", "actions": action_ids,
                               "old_b64": base64.b64encode(old).decode("ascii") if old is not None else None,
                               "old_mode": old_mode, "old_runtime": previous,
                               "new_sha256": digest(new), "applied_runtime": desired})
    try:
        atomic_file(new, old_mode)
        for key, value in desired.items():
            set_runtime(key, value)
        meta = json.loads((STATE / (receipt + ".json")).read_text(encoding="utf-8"))
        meta["status"] = "applied"
        save_manifest(receipt, meta)
    except BaseException:
        # Restore the previous file and runtime values on partial failure.
        atomic_file(old, old_mode)
        for key, value in previous.items():
            try:
                set_runtime(key, value)
            except Exception:
                pass
        meta = json.loads((STATE / (receipt + ".json")).read_text(encoding="utf-8"))
        meta["status"] = "failed_rolled_back_attempted"
        save_manifest(receipt, meta)
        raise
    return {"result": "applied", "actions": action_ids, "receipt": receipt,
            "configuration": str(CONFIG), "reboot_persistence": "drop-in written; validate boot loader and sysctl startup policy"}


def rollback(receipt: str) -> dict:
    if not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", receipt):
        raise RuntimeError("Malformed transaction ID")
    ensure_safe_dir(CONFIG.parent)
    ensure_safe_dir(STATE)
    path = STATE / (receipt + ".json")
    st = path.lstat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o077:
        raise RuntimeError("Untrusted receipt")
    obj = json.loads(path.read_text(encoding="utf-8"))
    if obj.get("status") != "applied":
        raise RuntimeError("Receipt has not been applied or has already been rolled back")
    original, current_mode = file_bytes()
    if digest(original) != obj.get("new_sha256"):
        raise RuntimeError("Config changed since this transaction; refuse to overwrite administrator edits or later changes")
    for key, value in obj["applied_runtime"].items():
        if key not in ALL_KEYS or value != next((v for a in ACTIONS.values() for k, v in a.items() if k == key), None):
            raise RuntimeError("Invalid receipt values")
        if current(key) != value:
            raise RuntimeError(f"Current {key} differs from receipt; preserve possible newer administrator changes")
    old_b64 = obj.get("old_b64")
    old = base64.b64decode(old_b64, validate=True) if old_b64 is not None else None
    mode = obj.get("old_mode")
    if not isinstance(mode, int) or mode < 0 or mode > 0o777:
        raise RuntimeError("Invalid backup mode")
    previous = obj["old_runtime"]
    for key, value in previous.items():
        if key not in ALL_KEYS or not isinstance(value, str) or not re.fullmatch(r"[0-3]", value):
            raise RuntimeError("Invalid previous setting")
    try:
        atomic_file(old, mode)
        for key, value in previous.items():
            set_runtime(key, value)
    except BaseException:
        # Attempt to re-establish the post-apply state if rollback itself is interrupted.
        atomic_file(original, current_mode)
        for key, value in obj["applied_runtime"].items():
            try:
                set_runtime(key, value)
            except Exception:
                pass
        raise
    obj["status"] = "rolled_back"
    save_manifest(receipt, obj)
    return {"result": "rolled_back", "receipt": receipt}



# Independent root-side allowlists: GUI-provided package identifiers and unit names
# are never trusted as executable commands or paths.
PACKAGE_BY_MANAGER = {
    "auditd": {"apt": "auditd", "dnf": "audit", "yum": "audit", "zypper": "audit", "pacman": "audit"},
    "fail2ban": {m: "fail2ban" for m in ("apt", "dnf", "yum", "zypper", "pacman")},
    "aide": {m: "aide" for m in ("apt", "dnf", "yum", "zypper", "pacman")},
    "ssh_server": {"apt": "openssh-server", "dnf": "openssh-server", "yum": "openssh-server",
                   "zypper": "openssh", "pacman": "openssh"},
    "password_quality": {"apt": "libpam-pwquality", "dnf": "libpwquality", "yum": "libpwquality",
                         "zypper": "pam_pwquality", "pacman": "libpwquality"},
    "unattended": {"apt": "unattended-upgrades", "dnf": "dnf-automatic", "yum": "dnf-automatic"},
    "ufw": {"apt": "ufw", "dnf": "ufw", "pacman": "ufw"},
    "firewalld": {"apt": "firewalld", "dnf": "firewalld", "yum": "firewalld",
                  "zypper": "firewalld", "pacman": "firewalld"},
}
SERVICE_ALLOWLIST = {"auditd.service", "fail2ban.service", "systemd-timesyncd.service",
                     "chrony.service", "chronyd.service", "telnet.socket", "rsh.socket", "rexec.socket"}


def detect_package_manager() -> tuple[str, str]:
    try:
        data = {}
        for line in Path('/etc/os-release').read_text(encoding='utf-8').splitlines():
            if '=' in line:
                key, value = line.split('=', 1)
                data[key] = value.strip().strip('"').strip("'")
        ids = {data.get('ID', ''), *data.get('ID_LIKE', '').split()}
    except OSError:
        ids = set()
    # Paths are deliberately fixed to root-owned system executables.
    options = []
    if ids & {'debian', 'ubuntu', 'linuxmint', 'pop'}:
        options = [('apt', '/usr/bin/apt-get')]
    elif ids & {'fedora', 'rhel', 'centos', 'rocky', 'almalinux', 'ol'}:
        options = [('dnf', '/usr/bin/dnf'), ('yum', '/usr/bin/yum')]
    elif ids & {'opensuse', 'opensuse-leap', 'opensuse-tumbleweed', 'suse', 'sles'}:
        options = [('zypper', '/usr/bin/zypper')]
    elif ids & {'arch', 'manjaro', 'endeavouros'}:
        options = [('pacman', '/usr/bin/pacman')]
    for name, path in options:
        if Path(path).is_file():
            return name, path
    raise RuntimeError('Unsupported or unrecognized distribution/package manager; no changes made')


def run_allowed(argv: list[str], timeout: int = 360) -> dict:
    # No shell, user-controlled environment, script names or executable paths.
    env = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C',
           'HOME': '/root', 'DEBIAN_FRONTEND': 'noninteractive'}
    result = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True,
                            text=True, errors='replace', timeout=timeout, env=env, check=False)
    if result.returncode:
        raise RuntimeError(f'Command exited {result.returncode}: {result.stderr[-1600:] or result.stdout[-1600:]}')
    return {'result': 'executed', 'program': Path(argv[0]).name,
            'details': result.stdout[-1200:], 'reboot_or_reconfiguration_may_be_required': True}


def install_package(key: str) -> dict:
    if key not in PACKAGE_BY_MANAGER:
        raise RuntimeError('Package is not allowlisted')
    manager, executable = detect_package_manager()
    package = PACKAGE_BY_MANAGER[key].get(manager)
    if not package:
        raise RuntimeError('This package is not mapped for the detected distribution')
    argv = {
        'apt': [executable, '-y', 'install', package],
        'dnf': [executable, '-y', 'install', package],
        'yum': [executable, '-y', 'install', package],
        'zypper': [executable, '--non-interactive', 'install', package],
        'pacman': [executable, '--noconfirm', '-S', '--needed', package],
    }[manager]
    result = run_allowed(argv)
    result.update({'package': package, 'package_manager': manager, 'undo': 'Package removal is not automated'})
    return result


def manage_service(operation: str, unit: str) -> dict:
    if unit not in SERVICE_ALLOWLIST or operation not in {'enable', 'disable'}:
        raise RuntimeError('Service operation not allowlisted')
    if unit in {'telnet.socket', 'rsh.socket', 'rexec.socket'} and operation != 'disable':
        raise RuntimeError('Legacy remote login units may only be disabled')
    result = run_allowed(['/usr/bin/systemctl', operation, '--now', unit], timeout=90)
    result.update({'unit': unit, 'operation': operation,
                   'undo': f'select the opposite service operation after verifying dependencies'})
    return result


def main() -> int:
    if os.geteuid() != 0:
        raise RuntimeError("Helper must be invoked with PolicyKit authorization/root")
    if len(sys.argv) < 3:
        raise RuntimeError("Usage: linfo-helper apply <allowlisted-id...> | rollback <transaction-uuid>")
    if sys.argv[1] == "apply":
        result = apply(sys.argv[2:])
    elif sys.argv[1] == "rollback" and len(sys.argv) == 3:
        result = rollback(sys.argv[2])
    elif sys.argv[1:3] == ["package", "install"] and len(sys.argv) == 4:
        result = install_package(sys.argv[3])
    elif sys.argv[1] == "service" and len(sys.argv) == 4:
        result = manage_service(sys.argv[2], sys.argv[3])
    else:
        raise RuntimeError("Unsupported operation")
    print(json.dumps(result, indent=2))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        print(f"LinFo hardening helper: {exc}", file=sys.stderr)
        sys.exit(1)
